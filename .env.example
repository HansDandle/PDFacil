# Copy to .env for local development. Never commit real values.

# Database (SQLite locally, Postgres on Railway)
DATABASE_URL=sqlite:///./storage/dev.sqlite3

# Object storage: "local" uses ./storage/objects, "r2" uses Cloudflare R2
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Auth (magic links via Resend)
RESEND_API_KEY=
SESSION_SECRET=change-me
APP_BASE_URL=http://localhost:8000

# Asset sources
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
